"""Asset bundle implementation contracts."""

# TODO(https://github.com/tamird/sty/blob/sty-action-v0.2.0/docs/type-interfaces.md#L60-L73):
# Move the describer's signature into asset_bundle.bzl when source
# comments can import Node; its weight field can be a local type alias.

load("@rules_runfiles_group//runfiles_group:types.bzli", _Node = "Node")

# TODO(https://github.com/bazelbuild/bazel/issues/32370): Use Ctx when a helper
# can declare which fields it reads through the aspect's ctx.rule.attr.
type _DescriberContext = ctx[object, object, struct[{"weight": int}, ...]]
