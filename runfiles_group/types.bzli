"""Types for the public runfiles group library."""

# TODO(https://github.com/tamird/sty/blob/sty-action-v0.2.0/docs/type-interfaces.md#L60-L73):
# Export these aliases from a .bzl module when source comments can
# re-export generic types for other modules; comment aliases are file-local.

load("//runfiles_group/private/lib:describe.bzli", _MergeFrom = "MergeFrom", _Node = "Node")
load("//runfiles_group/private/lib:resolved.bzli", _ResolvedGroups = "ResolvedGroups")

type MergeFrom[C: ctx[object, object]] = _MergeFrom[C]
type Node[C: ctx[object, object]] = _Node[C]
type ResolvedGroups[N: Label | str, T] = _ResolvedGroups[N, T]
