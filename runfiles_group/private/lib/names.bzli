"""Group names and values carrying one."""

# TODO(https://github.com/tamird/sty/blob/sty-action-v0.2.0/docs/type-interfaces.md#L141-L142):
# Move the lookup signatures into source when comments can bind the
# name and handle types in the resolved group index and its result.

load("//runfiles_group/private/providers:runfiles_group_partial_info.bzl", "RunfilesGroupPartialInfo")

class _Named(Protocol):
    @property
    def name(self) -> Label | str: ...

type SortKey = tuple[Literal[0], Label] | tuple[Literal[1], str]

type _Resolved[N: Label | str, T] = struct[{
    "by_name": Mapping[N, RunfilesGroupPartialInfo[T]],
}, ...]

def group_names[N: Label | str, T](resolved: _Resolved[N, T]) -> list[str]: ...

def index_by_name_str[N: Label | str, T](resolved: _Resolved[N, T]) -> dict[str, RunfilesGroupPartialInfo[T]]: ...
